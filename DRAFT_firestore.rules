rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity verification diagnostic document
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow write: if false;
    }

    // Fixed single-user X-29 application data document
    match /x29/{docId} {
      allow get, create, update, delete: if isValidId(docId);
      allow list: if false;
    }
  }
}
